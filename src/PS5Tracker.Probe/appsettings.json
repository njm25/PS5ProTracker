{
  "Probe": {
    "OutputDir": "runs",
    "Headless": true,
    "RequestTimeoutSeconds": 20,
    "MaxPrice": 899.99,
    "MaxConsecutiveErrors": 3,
    "MaxRunMinutes": 180,
    "DefaultRamp": {
      "IntervalsSeconds": [ 120, 60, 30, 15 ],
      "SamplesPerStep": 10,
      "Jitter": 0.15,
      "OnChallenge": "Stop",
      "CooldownMinutes": 60
    },
    "Credentials": {
      "BestBuyApiKey": null,
      "WalmartConsumerId": null,
      "WalmartKeyVersion": "1",
      "WalmartPrivateKeyPath": null
    },
    "Targets": [
      {
        "Name": "bestbuy-api",
        "Retailer": "Best Buy",
        "Method": "BestBuyApi",
        "Url": "https://api.bestbuy.com/v1/products/6601524.json?apiKey={BestBuyApiKey}&show=sku,name,salePrice,onlineAvailability,orderable,condition,inStoreAvailability",
        "ProductUrl": "https://www.bestbuy.com/product/playstation-5-pro-console/6601524",
        "Parser": "bestbuy-api",
        "Ramp": { "IntervalsSeconds": [ 60, 30, 10, 5, 2 ], "SamplesPerStep": 15 }
      },
      {
        "Name": "bestbuy-page",
        "Retailer": "Best Buy",
        "Method": "Browser",
        "Url": "https://www.bestbuy.com/product/playstation-5-pro-console/6601524",
        "Parser": "bestbuy-page",
        "Params": { "Sku": "6601524" },
        "AllowedSellers": [ "Best Buy" ],
        "WaitForSelector": "button[data-testid$='-6601524']",
        "SettleMs": 8000,
        "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 8 }
      },
      {
        "Name": "amazon-page",
        "Retailer": "Amazon",
        "Method": "Browser",
        "Enabled": false,
        "Url": "https://www.amazon.com/dp/B0DGY63Z2H",
        "Parser": "amazon-page",
        "AllowedSellers": [ "Amazon.com", "Amazon" ],
        "WaitForSelector": "#availability, #add-to-cart-button, #outOfStock",
        "SettleMs": 6000,
        "Ramp": { "IntervalsSeconds": [ 600, 300 ], "SamplesPerStep": 4 }
      },
      {
        "Name": "walmart-api",
        "Retailer": "Walmart",
        "Method": "WalmartAffiliateApi",
        "Url": "https://developer.api.walmart.com/api-proxy/service/affil/product/v2/items/11839818124",
        "ProductUrl": "https://www.walmart.com/ip/PLAYSTATION-PS5-PRO-CONSOLE/11839818124",
        "Parser": "walmart-affiliate-api",
        "AllowedSellers": [ "Walmart.com" ],
        "Ramp": { "IntervalsSeconds": [ 60, 30, 10, 5 ], "SamplesPerStep": 15 }
      },
      {
        "Name": "walmart-page",
        "Retailer": "Walmart",
        "Method": "Http",
        "Url": "https://www.walmart.com/ip/PLAYSTATION-PS5-PRO-CONSOLE/11839818124",
        "Parser": "walmart-nextdata",
        "Params": { "ItemId": "11839818124" },
        "AllowedSellers": [ "Walmart.com", "INTERNAL" ],
        "Ramp": { "IntervalsSeconds": [ 300, 120, 60 ], "SamplesPerStep": 6 }
      },
      {
        "Name": "psdirect-api",
        "Retailer": "PlayStation Direct",
        "Method": "Http",
        "Url": "https://api.direct.playstation.com/commercewebservices/ps-direct-us/users/anonymous/products/productList?fields=BASIC&productCodes=1000050928",
        "ProductUrl": "https://direct.playstation.com/en-us/buy-consoles/playstation5-pro-console-2-tb",
        "Parser": "psdirect-api",
        "AllowedSellers": [ "PlayStation Direct" ],
        "Ramp": { "IntervalsSeconds": [ 60, 30, 15, 5 ], "SamplesPerStep": 12 }
      },
      {
        "Name": "psdirect-api-bust",
        "Retailer": "PlayStation Direct",
        "Method": "Http",
        "Enabled": false,
        "Url": "https://api.direct.playstation.com/commercewebservices/ps-direct-us/users/anonymous/products/productList?fields=BASIC&productCodes=1000050928&_={nonce}",
        "ProductUrl": "https://direct.playstation.com/en-us/buy-consoles/playstation5-pro-console-2-tb",
        "Parser": "psdirect-api",
        "AllowedSellers": [ "PlayStation Direct" ],
        "Headers": { "Cache-Control": "no-cache", "Pragma": "no-cache" },
        "Ramp": { "IntervalsSeconds": [ 5 ], "SamplesPerStep": 72 }
      },
      {
        "Name": "psdirect-page",
        "Retailer": "PlayStation Direct",
        "Method": "Http",
        "Url": "https://direct.playstation.com/en-us/buy-consoles/playstation5-pro-console-2-tb",
        "Parser": "schema-offer",
        "Params": { "DefaultSeller": "PlayStation Direct" },
        "AllowedSellers": [ "PlayStation Direct", "Sony Interactive Entertainment", "PlayStation" ],
        "Ramp": { "IntervalsSeconds": [ 120, 60, 30 ] }
      },
      {
        "Name": "samsclub-page",
        "Retailer": "Sam's Club",
        "Method": "Http",
        "Url": "https://www.samsclub.com/ip/PlayStation-5-Pro-Console-2-TB/18717057017",
        "Parser": "walmart-nextdata",
        "Params": { "ItemId": "18717057017" },
        "AllowedSellers": [ "Sam's Club", "INTERNAL" ]
      },
      {
        "Name": "target-page",
        "Retailer": "Target",
        "Method": "Browser",
        "Url": "https://www.target.com/p/playstation-5-pro/-/A-93620188",
        "Parser": "target-page",
        "AllowedSellers": [ "Target" ],
        "WaitForSelector": "[data-test='product-price'], button[data-test='shipItButton'], button[data-test='orderPickupButton']",
        "SettleMs": 8000,
        "Ramp": { "IntervalsSeconds": [ 600, 300, 120 ], "SamplesPerStep": 6 }
      },
      {
        "Name": "gamestop-page",
        "Retailer": "GameStop",
        "Method": "Browser",
        "Url": "https://www.gamestop.com/consoles-hardware/playstation-5/consoles/products/sony-playstation-5-pro-console/20015604.html",
        "Parser": "gamestop-page",
        "Params": { "Sku": "416188", "Pid": "20015604" },
        "AllowedSellers": [ "GameStop" ],
        "WaitForSelector": "button.add-to-cart",
        "SettleMs": 8000,
        "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 8 }
      },
      {
        "Name": "newegg-page",
        "Retailer": "Newegg",
        "Method": "Browser",
        "Url": "https://www.newegg.com/p/N82E16868110346",
        "Parser": "newegg-page",
        "AllowedSellers": [ "Newegg" ],
        "SettleMs": 3000,
        "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 8 }
      }
    ],
    "Profiles": {
      "fast": {
        "MaxRunMinutes": 120,
        "Targets": {
          "psdirect-api": { "Ramp": { "IntervalsSeconds": [ 5, 3, 2, 1 ], "SamplesPerStep": 30 } },
          "psdirect-api-bust": { "Ramp": { "IntervalsSeconds": [ 5 ], "SamplesPerStep": 72 } },
          "psdirect-page": { "Ramp": { "IntervalsSeconds": [ 30, 15, 10, 5 ], "SamplesPerStep": 10 } },
          "samsclub-page": { "Ramp": { "IntervalsSeconds": [ 15, 10, 5, 3 ], "SamplesPerStep": 10 } },
          "walmart-page": { "Ramp": { "IntervalsSeconds": [ 60, 30, 15 ], "SamplesPerStep": 8 } },
          "target-page": { "Ramp": { "IntervalsSeconds": [ 120, 60, 30 ], "SamplesPerStep": 6 } }
        }
      },
      "headed": {
        "Headless": false,
        "MaxRunMinutes": 180,
        "Targets": {
          "bestbuy-page": { "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 6 } },
          "gamestop-page": { "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 6 } },
          "newegg-page": { "Ramp": { "IntervalsSeconds": [ 300, 120, 60, 30 ], "SamplesPerStep": 6 } }
        }
      }
    }
  }
}
